{
  "name": "nryn-backend",
  "version": "1.0.0",
  "description": "NRYN Email Module Backend with Node, Express and Supabase",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "node scripts/free-port.js 4000 && npm run build",
    "start": "node dist/server.js",
    "kill-port": "node scripts/free-port.js 4000",
    "dev": "node scripts/free-port.js 4000 && tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
