{
  "expo": {
    "name": "NRYN",
    "slug": "nryn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nryn",
    "splash": {
      "backgroundColor": "#fdfcf9"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NRYN requires microphone access to record voice meetings and generate automated Minutes of Meeting (MoM)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fdfcf9"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow NRYN to access your microphone to record voice meetings."
        }
      ]
    ]
  }
}
